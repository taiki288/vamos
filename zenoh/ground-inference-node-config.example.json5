{
  zenoh_key_prefix: "vamos",
  node_state_publish_frequency_hz: 10.0,
  cli_heartbeat_timeout_seconds: 1.0,
  camera: { key: "camera/front", frame_freshness_seconds: 2.5 },
  go2: { zenoh_key_prefix: "unitree/go2", node_state_timeout_seconds: 0.5 },
  inference: {
    stop_go: {
      inference_timeout_seconds: 60.0,
      max_step_seconds: 1.0,
      max_step_distance_m: 0.2,
      max_step_yaw_rad: 0.35,
      stop_settle_seconds: 0.2,
      stop_confirm_timeout_seconds: 15.0, // Includes a Go2 stand-up on the first cycle.
      observation_delay_seconds: 0.2, // Camera latency margin after stopped feedback.
    },
    model_key: "mateoguaman/vamos",
    device: "cuda",
    num_samples: 10,
    max_new_tokens: 10,
    temperature: 0.05,
    disable_compile: true,
    frequency_hz: 1.0,
    shutdown_timeout_seconds: 30.0,
    goal: {
      x: 0.5,
      y: 0.6,
      instruction: "Follow the open paved path toward the goal while avoiding people.",
    },
  },
}
