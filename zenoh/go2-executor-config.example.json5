{
  // Relative paths are resolved against this file's directory. The executor
  // refuses an unverified ("assumed") calibration unless explicitly allowed.
  camera_calibration: "ground-camera.json",
  allow_assumed_calibration: false, // Set true only for robot-free tests.

  // "go2": robot_state.position/yaw from the Go2 node (proposed fields).
  // "dead_reckoning": integrate this executor's own commands; drifts over long runs.
  pose_source: "dead_reckoning",

  selection: "medoid", // "medoid" or "index" (uses candidate_index).
  candidate_index: 0,
  min_path_length_m: 0.05,

  control_frequency_hz: 20.0, // Go2 drops velocity after 0.25 s without a refresh.
  node_state_timeout_seconds: 1.0,
  result_validity_seconds: 3.0, // From result receipt to the end of its step.
  shutdown_timeout_seconds: 15.0,

  goal: {
    arrival_tolerance_m: 0.5, // Also reached once the goal is in the camera's near blind zone.
    turn_tolerance_rad: 0.05,
  },

  go2: {
    state_timeout_seconds: 0.5,
    stand_timeout_seconds: 10.0,
    down_timeout_seconds: 10.0,
  },

  // Step bounds (distance, yaw, duration, settling) come from the node
  // config's inference.stop_go section.
  motion: {
    forward_speed_mps: 0.3,
    max_yaw_rate_rps: 0.6,
    lookahead_distance_m: 0.4,
    goal_tolerance_m: 0.05,
    slowdown_distance_m: 0.2,
    rotate_threshold_rad: 0.6,
  },
}
