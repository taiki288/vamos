{
  zenoh_key_prefix: "vamos",
  node_state_publish_frequency_hz: 10.0,
  cli_heartbeat_timeout_seconds: 1.0,
  camera: {
    key: "camera/front",
    frame_freshness_seconds: 2.5,
  },
  go2: {
    zenoh_key_prefix: "unitree/go2",
    node_state_timeout_seconds: 0.5,
  },
  inference: {
    model_key: "mateoguaman/vamos",
    device: "cuda", // "auto" or "cpu" may also be selected explicitly.
    num_samples: 10,
    max_new_tokens: 10,
    temperature: 0.05,
    disable_compile: true, // Keep streaming results within the freshness window.
    frequency_hz: 1.0, // Missed inference slots are skipped; no overlap/backlog.
    max_frame_age_seconds: 5.0,
    shutdown_timeout_seconds: 30.0,
    goal: {
      x: 0.434,
      y: 0.514,
      instruction: "Make a sharp right arc to avoid the people in front. Move along that arc towards the goal keeping the people to the left of you.",
    },
  },
}
